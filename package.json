{
  "name": "@stratosphere-network/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "StratoSphere  network Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
