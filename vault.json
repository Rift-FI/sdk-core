      "/vault/user/me": {
        "get": {
          "tags": ["User"],
          "summary": "Get current user's vault data",
          "description": "Returns comprehensive vault data for the authenticated user including balance, rewards, and pending request status. The user's smart wallet address is derived from their encrypted private key stored in the database.",
          "security": [
            { "ApiKeyAuth": [] },
            { "BearerAuth": [] }
          ],
          "responses": {
            "200": {
              "description": "User data retrieved successfully",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/UserData" },
                  "example": {
                    "address": "0xD692AA908584135208EF8e15F6c63Ac0535A842b",
                    "balance": "1000.00",
                    "rewards": "50.00",
                    "hasPendingClaim": false,
                    "pendingWithdrawal": "0",
                    "hasPendingWithdrawal": false
                  }
                }
              }
            },
            "401": {
              "description": "Unauthorized - Missing or invalid JWT token",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/Error" }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/Error" }
                }
              }
            }
          }
        }
      },
      "/vault/user/me/balance": {
        "get": {
          "tags": ["User"],
          "summary": "Get current user's deposited balance",
          "description": "Returns the authenticated user's deposited USDC balance in the vault.",
          "security": [
            { "ApiKeyAuth": [] },
            { "BearerAuth": [] }
          ],
          "responses": {
            "200": {
              "description": "Balance retrieved successfully",
              "content": {
                "application/json": {
                  "schema": {
