{
    "openapi": "3.0.3",
    "info": {
      "title": "SAIL.R Trading API",
      "description": "API for buying and selling SAIL.R tokens with USDC on Base and Berachain. Supports gasless transactions via smart wallets and automatic cross-chain swaps.",
      "version": "1.0.0",
      "contact": {
        "name": "Rift Finance",
        "url": "https://riftfi.xyz"
      }
    },
    "servers": [
      {
        "url": "https://api.riftfi.xyz",
        "description": "Production server"
      },
      {
        "url": "http://localhost:8000",
        "description": "Development server"
      }
    ],
    "security": [
      {
        "BearerAuth": [],
        "ApiKeyAuth": []
      }
    ],
    "tags": [
      {
        "name": "Quotes",
        "description": "Get cost estimates before executing trades (read-only)"
      },
      {
        "name": "Trading",
        "description": "Execute buy and sell transactions"
      }
    ],
    "paths": {
      "/api/sailr/buy/quote": {
        "get": {
          "tags": ["Quotes"],
          "summary": "Get buy quote",
          "description": "Get a detailed cost estimate for buying SAIL.R with USDC. This is a read-only endpoint that returns all fees, gas costs, and expected output without executing any transactions.",
          "operationId": "getBuyQuote",
          "parameters": [
            {
              "name": "amount",
              "in": "query",
              "description": "USDC amount in wei (6 decimals). Example: '1000000' = 1 USDC",
              "required": true,
              "schema": {
                "type": "string",
                "example": "1000000"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful quote response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/BuyQuoteResponse"
                  },
                  "example": {
                    "success": true,
                    "quote": {
                      "usdcToSwap": 1000000,
                      "usdcToSwapFormatted": "1 USDC",
                      "fees": {
                        "gasRefund": 2200001,
                        "gasRefundFormatted": "2.200001 USDC",
                        "ethGas": "0.000654383881216238",
                        "beraGas": "1.0"
                      },
                      "totalUsdcNeeded": 3200001,
                      "totalUsdcNeededFormatted": "3.200001 USDC",
                      "balances": {
                        "smartWallet": 5000000,
                        "smartWalletFormatted": "5 USDC",
                        "eoa": 0,
                        "eoaFormatted": "0 USDC",
                        "needsTransfer": true,
                        "transferAmount": 3200001,
                        "transferAmountFormatted": "3.200001 USDC"
                      },
                      "estimatedSailR": "68263613975780279",
                      "estimatedSailRFormatted": "0.068263613975780279 SAIL.R",
                      "route": {
                        "isMultiHop": false,
                        "steps": 1,
                        "provider": "enso"
                      },
                      "canExecute": true,
                      "warnings": []
                    },
                    "priceInfo": {
                      "usdcPerSailR": 14.64972,
                      "effectiveRate": "1 SAIL.R ≈ 0.014650 USDC"
                    }
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            }
          }
        }
      },
      "/api/sailr/buy": {
        "post": {
          "tags": ["Trading"],
          "summary": "Buy SAIL.R",
          "description": "Execute a buy transaction to purchase SAIL.R tokens with USDC. The system handles USDC transfers from smart wallet to EOA, gas funding, router approvals, and cross-chain swaps automatically. SAIL.R tokens will be delivered to your EOA on Berachain.",
          "operationId": "buySailR",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuyRequest"
                },
                "example": {
                  "amount": "1000000"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Successful buy transaction",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/BuyResponse"
                  },
                  "example": {
                    "success": true,
                    "message": "SAIL.R purchase completed successfully",
                    "smartWalletToEOA": "0x1234567890abcdef...",
                    "swapTransactions": [
                      "0xabcdef1234567890..."
                    ],
                    "refund": {
                      "ethSent": "0.000654383881216238",
                      "beraSent": "1.0",
                      "refundTxHash": "0xfedcba0987654321..."
                    },
                    "estimatedSailR": "68263613975780279",
                    "eoaAddress": "0xC9AA473460C6b9A1f502e1488d4A9A35E6014efb"
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            }
          }
        }
      },
      "/api/sailr/sell/quote": {
        "get": {
          "tags": ["Quotes"],
          "summary": "Get sell quote",
          "description": "Get a detailed estimate for selling SAIL.R tokens for USDC. Returns gross USDC from swap, gas costs, and net USDC after fees. This is a read-only endpoint.",
          "operationId": "getSellQuote",
          "parameters": [
            {
              "name": "amount",
              "in": "query",
              "description": "SAIL.R amount in wei (18 decimals). Example: '5000000000000000' = 0.005 SAIL.R",
              "required": true,
              "schema": {
                "type": "string",
                "example": "5000000000000000"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful quote response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/SellQuoteResponse"
                  },
                  "example": {
                    "success": true,
                    "quote": {
                      "sailrToSell": "5000000000000000",
                      "sailrToSellFormatted": "0.005 SAIL.R",
                      "estimatedUsdcGross": 73250,
                      "estimatedUsdcGrossFormatted": "0.07325 USDC",
                      "fees": {
                        "gasRefund": 2200001,
                        "gasRefundFormatted": "2.200001 USDC",
                        "ethGas": "0.000654383881216238",
                        "beraGas": "0"
                      },
                      "estimatedUsdcNet": -2126751,
                      "estimatedUsdcNetFormatted": "-2.126751 USDC",
                      "balances": {
                        "sailrInEoa": "9129102765263455",
                        "sailrInEoaFormatted": "0.009129102765263455 SAIL.R",
                        "hasSufficientSailr": true
                      },
                      "route": {
                        "isMultiHop": false,
                        "steps": 1,
                        "provider": "enso"
                      },
                      "canExecute": true,
                      "warnings": []
                    },
                    "priceInfo": {
                      "sailrPerUsdc": 68.25939,
                      "effectiveRate": "1 USDC ≈ 68.259390 SAIL.R"
                    }
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            }
          }
        }
      },
      "/api/sailr/sell": {
        "post": {
          "tags": ["Trading"],
          "summary": "Sell SAIL.R",
          "description": "Execute a sell transaction to exchange SAIL.R tokens for USDC. The system handles gas funding, router approvals, cross-chain swaps, and optionally transfers USDC back to your smart wallet. SAIL.R must be in your EOA on Berachain.",
          "operationId": "sellSailR",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellRequest"
                },
                "example": {
                  "amount": "5000000000000000",
                  "returnToSmartWallet": true
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Successful sell transaction",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/SellResponse"
                  },
                  "example": {
                    "success": true,
                    "message": "SAIL.R sold successfully",
                    "swapTransactions": [
                      "0x7471e83315195f0db621cfb03e222cad20ae4e7d..."
                    ],
                    "refund": {
                      "ethSent": "0.000654383881216238",
                      "beraSent": "0",
                      "refundTxHash": "0x9876543210fedcba..."
                    },
                    "eoaToSmartWallet": "0x1234567890abcdef...",
                    "estimatedUsdc": "73250",
                    "eoaAddress": "0xC9AA473460C6b9A1f502e1488d4A9A35E6014efb"
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            }
          }
        }
      }
    },
    "components": {
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "description": "JWT token obtained from authentication endpoint"
        },
        "ApiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "x-api-key",
          "description": "API key for project authentication"
        }
      },
      "schemas": {
        "BuyQuoteResponse": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "quote": {
              "type": "object",
              "properties": {
                "usdcToSwap": {
                  "type": "integer",
                  "description": "USDC amount to swap (wei, 6 decimals)",
                  "example": 1000000
                },
                "usdcToSwapFormatted": {
                  "type": "string",
                  "description": "Human-readable USDC swap amount",
                  "example": "1 USDC"
                },
                "fees": {
                  "$ref": "#/components/schemas/Fees"
                },
                "totalUsdcNeeded": {
                  "type": "integer",
                  "description": "Total USDC required (swap + gas refund)",
                  "example": 3200001
                },
                "totalUsdcNeededFormatted": {
                  "type": "string",
                  "description": "Human-readable total cost",
                  "example": "3.200001 USDC"
                },
                "balances": {
                  "$ref": "#/components/schemas/BuyBalances"
                },
                "estimatedSailR": {
                  "type": "string",
                  "description": "Estimated SAIL.R to receive (wei, 18 decimals)",
                  "example": "68263613975780279"
                },
                "estimatedSailRFormatted": {
                  "type": "string",
                  "description": "Human-readable SAIL.R amount",
                  "example": "0.068263613975780279 SAIL.R"
                },
                "route": {
                  "$ref": "#/components/schemas/RouteInfo"
                },
                "canExecute": {
                  "type": "boolean",
                  "description": "Whether user has sufficient balance to execute",
                  "example": true
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Array of warning messages",
                  "example": []
                }
              }
            },
            "priceInfo": {
              "$ref": "#/components/schemas/PriceInfo"
            }
          }
        },
        "SellQuoteResponse": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "quote": {
              "type": "object",
              "properties": {
                "sailrToSell": {
                  "type": "string",
                  "description": "SAIL.R amount to sell (wei, 18 decimals)",
                  "example": "5000000000000000"
                },
                "sailrToSellFormatted": {
                  "type": "string",
                  "description": "Human-readable SAIL.R amount",
                  "example": "0.005 SAIL.R"
                },
                "estimatedUsdcGross": {
                  "type": "integer",
                  "description": "Gross USDC from swap (before gas refund)",
                  "example": 73250
                },
                "estimatedUsdcGrossFormatted": {
                  "type": "string",
                  "description": "Human-readable gross USDC",
                  "example": "0.07325 USDC"
                },
                "fees": {
                  "$ref": "#/components/schemas/Fees"
                },
                "estimatedUsdcNet": {
                  "type": "integer",
                  "description": "Net USDC after gas refund (can be negative)",
                  "example": -2126751
                },
                "estimatedUsdcNetFormatted": {
                  "type": "string",
                  "description": "Human-readable net USDC",
                  "example": "-2.126751 USDC"
                },
                "balances": {
                  "$ref": "#/components/schemas/SellBalances"
                },
                "route": {
                  "$ref": "#/components/schemas/RouteInfo"
                },
                "canExecute": {
                  "type": "boolean",
                  "description": "Whether user has sufficient SAIL.R to execute",
                  "example": true
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Array of warning messages",
                  "example": []
                }
              }
            },
            "priceInfo": {
              "$ref": "#/components/schemas/PriceInfo"
            }
          }
        },
        "BuyRequest": {
          "type": "object",
          "required": ["amount"],
          "properties": {
            "amount": {
              "type": "string",
              "description": "USDC amount in wei (6 decimals). Example: '1000000' = 1 USDC",
              "example": "1000000"
            }
          }
        },
        "SellRequest": {
          "type": "object",
          "required": ["amount"],
          "properties": {
            "amount": {
              "type": "string",
              "description": "SAIL.R amount in wei (18 decimals). Example: '5000000000000000' = 0.005 SAIL.R",
              "example": "5000000000000000"
            },
            "returnToSmartWallet": {
              "type": "boolean",
              "description": "Whether to transfer USDC back to smart wallet after swap (default: true)",
              "default": true,
              "example": true
            }
          }
        },
        "BuyResponse": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "message": {
              "type": "string",
              "example": "SAIL.R purchase completed successfully"
            },
            "smartWalletToEOA": {
              "type": "string",
              "description": "Transaction hash for USDC transfer from smart wallet to EOA (if executed)",
              "example": "0x1234567890abcdef..."
            },
            "swapTransactions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of swap transaction hashes (single or multi-hop)",
              "example": ["0xabcdef1234567890..."]
            },
            "refund": {
              "type": "object",
              "properties": {
                "ethSent": {
                  "type": "string",
                  "description": "ETH sent to EOA on Base",
                  "example": "0.000654383881216238"
                },
                "beraSent": {
                  "type": "string",
                  "description": "BERA sent to EOA on Berachain",
                  "example": "1.0"
                },
                "refundTxHash": {
                  "type": "string",
                  "description": "Transaction hash for gas refund to relayer",
                  "example": "0xfedcba0987654321..."
                }
              },
              "description": "Gas refund details (only if gas was funded)"
            },
            "estimatedSailR": {
              "type": "string",
              "description": "Estimated SAIL.R amount received",
              "example": "68263613975780279"
            },
            "eoaAddress": {
              "type": "string",
              "description": "EOA address where SAIL.R will be received",
              "example": "0xC9AA473460C6b9A1f502e1488d4A9A35E6014efb"
            }
          }
        },
        "SellResponse": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "message": {
              "type": "string",
              "example": "SAIL.R sold successfully"
            },
            "swapTransactions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of swap transaction hashes",
              "example": ["0x7471e83315195f0db621cfb03e222cad20ae4e7d..."]
            },
            "refund": {
              "type": "object",
              "properties": {
                "ethSent": {
                  "type": "string",
                  "description": "ETH sent to EOA on Base",
                  "example": "0.000654383881216238"
                },
                "beraSent": {
                  "type": "string",
                  "description": "BERA sent to EOA on Berachain",
                  "example": "0"
                },
                "refundTxHash": {
                  "type": "string",
                  "description": "Transaction hash for gas refund to relayer",
                  "example": "0x9876543210fedcba..."
                }
              },
              "description": "Gas refund details (only if gas was funded)"
            },
            "eoaToSmartWallet": {
              "type": "string",
              "description": "Transaction hash for USDC transfer from EOA to smart wallet",
              "example": "0x1234567890abcdef..."
            },
            "estimatedUsdc": {
              "type": "string",
              "description": "Estimated USDC amount received",
              "example": "73250"
            },
            "eoaAddress": {
              "type": "string",
              "description": "EOA address used for the transaction",
              "example": "0xC9AA473460C6b9A1f502e1488d4A9A35E6014efb"
            }
          }
        },
        "Fees": {
          "type": "object",
          "properties": {
            "gasRefund": {
              "type": "integer",
              "description": "Gas refund amount in USDC (wei)",
              "example": 2200001
            },
            "gasRefundFormatted": {
              "type": "string",
              "description": "Human-readable gas refund",
              "example": "2.200001 USDC"
            },
            "ethGas": {
              "type": "string",
              "description": "ETH gas amount (if needed)",
              "example": "0.000654383881216238"
            },
            "beraGas": {
              "type": "string",
              "description": "BERA gas amount (if needed)",
              "example": "1.0"
            }
          }
        },
        "BuyBalances": {
          "type": "object",
          "properties": {
            "smartWallet": {
              "type": "integer",
              "description": "USDC balance in smart wallet (wei)",
              "example": 5000000
            },
            "smartWalletFormatted": {
              "type": "string",
              "description": "Human-readable smart wallet balance",
              "example": "5 USDC"
            },
            "eoa": {
              "type": "integer",
              "description": "USDC balance in EOA (wei)",
              "example": 0
            },
            "eoaFormatted": {
              "type": "string",
              "description": "Human-readable EOA balance",
              "example": "0 USDC"
            },
            "needsTransfer": {
              "type": "boolean",
              "description": "Whether USDC needs to be transferred to EOA",
              "example": true
            },
            "transferAmount": {
              "type": "integer",
              "description": "Amount to transfer from smart wallet to EOA",
              "example": 3200001
            },
            "transferAmountFormatted": {
              "type": "string",
              "description": "Human-readable transfer amount",
              "example": "3.200001 USDC"
            }
          }
        },
        "SellBalances": {
          "type": "object",
          "properties": {
            "sailrInEoa": {
              "type": "string",
              "description": "SAIL.R balance in EOA (wei, 18 decimals)",
              "example": "9129102765263455"
            },
            "sailrInEoaFormatted": {
              "type": "string",
              "description": "Human-readable SAIL.R balance",
              "example": "0.009129102765263455 SAIL.R"
            },
            "hasSufficientSailr": {
              "type": "boolean",
              "description": "Whether EOA has enough SAIL.R",
              "example": true
            }
          }
        },
        "RouteInfo": {
          "type": "object",
          "properties": {
            "isMultiHop": {
              "type": "boolean",
              "description": "Whether swap requires multiple transactions",
              "example": false
            },
            "steps": {
              "type": "integer",
              "description": "Number of swap steps",
              "example": 1
            },
            "provider": {
              "type": "string",
              "description": "Swap provider (enso or lifi)",
              "example": "enso",
              "enum": ["enso", "lifi"]
            }
          }
        },
        "PriceInfo": {
          "type": "object",
          "properties": {
            "usdcPerSailR": {
              "type": "number",
              "description": "USDC price per SAIL.R",
              "example": 14.64972
            },
            "sailrPerUsdc": {
              "type": "number",
              "description": "SAIL.R price per USDC (sell quotes only)",
              "example": 68.25939
            },
            "effectiveRate": {
              "type": "string",
              "description": "Human-readable exchange rate",
              "example": "1 SAIL.R ≈ 0.014650 USDC"
            }
          }
        },
        "ErrorResponse": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": false
            },
            "error": {
              "type": "string",
              "description": "Error message",
              "example": "Missing required fields (amount, userId, smartWalletAddress)"
            }
          }
        }
      },
      "responses": {
        "BadRequest": {
          "description": "Bad request - Missing or invalid parameters",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              "example": {
                "success": false,
                "error": "Missing required fields (amount, userId, smartWalletAddress)"
              }
            }
          }
        },
        "Unauthorized": {
          "description": "Unauthorized - Invalid or missing authentication",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              "example": {
                "success": false,
                "error": "Invalid or expired JWT token"
              }
            }
          }
        },
        "InternalError": {
          "description": "Internal server error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              "example": {
                "success": false,
                "error": "Failed to get swap quote"
              }
            }
          }
        }
      }
    }
  }
  
  